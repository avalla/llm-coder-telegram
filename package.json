{
  "name": "telegram-coding-agent-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "check": "bun run typecheck && bun run lint && bun run test && bun run format:check",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "latest",
    "prettier": "latest",
    "typescript": "5.9.3",
    "vitest": "latest"
  }
}
